# Cache + security policy in the Cloudflare Pages / Netlify `_headers` format.
#
# NOTE: production is served by Vercel (verified via `x-vercel-cache` on www.siwina.com),
# and Vercel ignores this file — `vercel.json` is the one that actually takes effect.
# This file is kept in sync for the Cloudflare Pages deployment that also builds this repo.
#
# Cloudflare then proxies the domain, and its "Browser Cache TTL" setting overrides the
# origin's Cache-Control unless it is set to "Respect Existing Headers". Without that,
# everything is capped at 4 hours regardless of what is declared here or in vercel.json.
#
# Rule order matters: Cloudflare Pages applies every matching rule and lets the LAST
# one win for a repeated header. The catch-all therefore only carries security headers,
# and the asset rules below own Cache-Control outright.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Angular fingerprints its own JS/CSS output, so those bytes can never go stale.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable

# Copied verbatim from `public/`, so the names are stable rather than hashed:
# long TTL, but still revalidating.
/fonts/*
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

# Angular copies public/ verbatim, so these names do not change when the bytes do. A
# 30-day max-age pinned the old encode at the CDN: the q68 -> q62 re-encode never reached
# visitors. One day in the browser, with a long stale-while-revalidate window so the CDN
# still answers instantly and refreshes behind the request.
#
# Content-addressed names would be better and were tried. They do not work here: the app
# runs without hydration, so Angular rebuilds the DOM from the compiled templates, and
# those still carry the unhashed paths — rewriting only the prerendered HTML left every
# image 404ing once the framework booted.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

# Same trap as /images/*: the name never changes when the bytes do, and a 30-day
# max-age pinned Angular's default favicon at the CDN even after the real one shipped.
# Google reads /favicon.ico at the root by convention, so it cannot be fingerprinted.
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
